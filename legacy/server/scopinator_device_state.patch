+    async def _refresh_device_state(self):
+        """Background task that periodically refreshes device state."""
+        await asyncio.sleep(10)  # Initial delay
+        while self.is_connected:
+            try:
+                if self.connection.is_connected() and not self._reconnect_in_progress:
+                    logging.trace(f"Refreshing device state for {self}")
+                    response = await self.send_and_recv(GetDeviceState())
+                    if response and response.result:
+                        # Store the full device state
+                        self.status.device_state = response.result
+                        self.status.last_device_state_update = time.time()
+                        
+                        # Also update pi_status if available
+                        if hasattr(response.result, 'pi_status'):
+                            self.status.pi_status = response.result.pi_status
+                        
+                        logging.trace(f"Device state updated for {self}")
+                await asyncio.sleep(self.device_state_refresh_interval)
+            except Exception as e:
+                logging.error(f"Failed to refresh device state for {self}: {e}")
+                await asyncio.sleep(self.device_state_refresh_interval)
+                continue
 

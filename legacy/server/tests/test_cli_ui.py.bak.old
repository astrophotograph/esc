"""
Comprehensive tests for CLI UI components.
Part of Phase 4: UI and Utilities testing
"""

import pytest
import asyncio
import json
from unittest.mock import AsyncMock, MagicMock, patch
from textual.widgets import DataTable, Button, Static
from textual.app import App
from textual.containers import VerticalScroll

from cli.ui import DevicePickerScreen, DevicePickerApp, CombinedSeestarUI


class TestDevicePickerScreen:
    """Test the DevicePickerScreen component"""
    
    @pytest.fixture
    def mock_devices(self):
        """Create mock device data"""
        return [
            {
                "address": "192.168.1.100",
                "data": {"name": "Seestar S50", "model": "S50", "version": "1.0.0"}
            },
            {
                "address": "192.168.1.101", 
                "data": {"name": "Seestar S30", "model": "S30", "version": "1.1.0"}
            }
        ]
    
    @pytest.fixture
    def screen(self, mock_devices):
        """Create a DevicePickerScreen instance"""
        return DevicePickerScreen(mock_devices)
    
    def test_screen_initialization(self, screen, mock_devices):
        """Test screen is initialized with devices"""
        assert screen.devices == mock_devices
        assert screen.selected_device is None
    
    def test_compose_creates_widgets(self, screen):
        """Test compose method creates all required widgets"""
        widgets = list(screen.compose())
        
        # Should have Header, VerticalScroll container, and Footer
        widget_types = [type(w).__name__ for w in widgets]
        assert "Header" in widget_types
        assert "Footer" in widget_types
        
        # Check for specific widgets by iterating through compose
        has_instructions = False
        has_table = False
        has_button = False
        
        for widget in widgets:
            if hasattr(widget, 'id'):
                if widget.id == "instructions":
                    has_instructions = True
                elif widget.id == "devices-table":
                    has_table = True
                elif widget.id == "connect-button":
                    has_button = True
        
        # Check within VerticalScroll
        for widget in widgets:
            if isinstance(widget, VerticalScroll):
                # VerticalScroll yields its children
                assert True  # Just verify it exists
    
    @pytest.mark.asyncio
    async def test_on_mount_populates_table(self, screen, mock_devices):
        """Test on_mount populates the devices table"""
        # Create mock table
        mock_table = MagicMock(spec=DataTable)
        
        # Mock query_one to return our mock table
        screen.query_one = MagicMock(return_value=mock_table)
        
        # Call on_mount
        screen.on_mount()
        
        # Verify table setup
        mock_table.add_columns.assert_called_once_with("IP Address", "Device Info")
        
        # Verify rows added
        assert mock_table.add_row.call_count == 2
        
        # Check first device
        first_call = mock_table.add_row.call_args_list[0]
        assert first_call[0][0] == "192.168.1.100"
        assert "Seestar S50" in first_call[0][1]
        
        # Check second device
        second_call = mock_table.add_row.call_args_list[1]
        assert second_call[0][0] == "192.168.1.101"
        assert "Seestar S30" in second_call[0][1]
    
    def test_on_mount_handles_malformed_device_data(self, screen):
        """Test on_mount handles devices with malformed data"""
        # Create devices with bad data
        screen.devices = [
            {"address": "192.168.1.100"},  # Missing data key
            {"address": "192.168.1.101", "data": None},  # None data
            {"address": "192.168.1.102", "data": "not a dict"}  # Invalid data type
        ]
        
        mock_table = MagicMock(spec=DataTable)
        screen.query_one = MagicMock(return_value=mock_table)
        
        # Should not raise exception
        screen.on_mount()
        
        # Should add all devices even with bad data
        assert mock_table.add_row.call_count == 3
        
        # Check that "Unknown device info" is used for bad data
        for call in mock_table.add_row.call_args_list:
            if call[0][0] != "192.168.1.100":  # Skip the one that might have worked
                assert "Unknown device info" in call[0][1] or "not a dict" in call[0][1]
    
    def test_on_data_table_row_highlighted(self, screen):
        """Test row selection in data table"""
        # Mock the UI elements
        mock_table = MagicMock()
        mock_button = MagicMock()
        
        screen.query_one = MagicMock(side_effect=lambda id: {
            "#devices-table": mock_table,
            "#connect-button": mock_button
        }.get(id))
        
        # Create a mock event
        mock_event = MagicMock()
        mock_event.row_key.value = 0
        
        # Call the handler
        screen.on_data_table_row_highlighted(mock_event)
        
        # Verify button is enabled and device is selected
        mock_button.set_property.assert_called_with("disabled", False)
        assert screen.selected_device == screen.devices[0]
    
    def test_on_button_pressed(self, screen):
        """Test connect button press"""
        # Set a selected device
        screen.selected_device = screen.devices[0]
        
        # Mock the app dismiss
        screen.app = MagicMock()
        
        # Create mock event
        mock_event = MagicMock()
        mock_event.button.id = "connect-button"
        
        # Call handler
        screen.on_button_pressed(mock_event)
        
        # Verify app dismisses with selected device
        screen.app.exit.assert_called_once_with(screen.selected_device)


class TestDevicePickerApp:
    """Test the DevicePickerApp"""
    
    @pytest.fixture
    def mock_devices(self):
        """Create mock device data"""
        return [
            {
                "address": "192.168.1.100",
                "data": {"name": "Seestar S50"}
            }
        ]
    
    @pytest.fixture
    def app(self, mock_devices):
        """Create DevicePickerApp instance"""
        return DevicePickerApp(mock_devices)
    
    def test_app_initialization(self, app, mock_devices):
        """Test app is initialized with devices"""
        assert app.devices == mock_devices
    
    def test_on_mount_pushes_screen(self, app):
        """Test on_mount pushes the device picker screen"""
        # Mock push_screen
        app.push_screen = MagicMock()
        
        # Call on_mount
        app.on_mount()
        
        # Verify screen is pushed
        app.push_screen.assert_called_once()
        
        # Get the screen that was pushed
        pushed_screen = app.push_screen.call_args[0][0]
        assert isinstance(pushed_screen, DevicePickerScreen)
        assert pushed_screen.devices == app.devices


class TestCombinedSeestarUI:
    """Test the CombinedSeestarUI component"""
    
    @pytest.fixture
    def mock_client(self):
        """Create mock SeestarClient"""
        client = MagicMock()
        client.connected = True
        client.host = "192.168.1.100"
        client.port = 4700
        client.get_view_state = AsyncMock(return_value={
            "ra": 12.5,
            "dec": 45.2,
            "mode": "tracking"
        })
        client.events = []
        return client
    
    @pytest.fixture
    def ui(self, mock_client):
        """Create CombinedSeestarUI instance"""
        return CombinedSeestarUI(mock_client)
    
    def test_ui_initialization(self, ui, mock_client):
        """Test UI is initialized with client"""
        assert ui.client == mock_client
        assert ui.update_task is None
    
    def test_compose_creates_widgets(self, ui):
        """Test compose creates all required widgets"""
        widgets = list(ui.compose())
        
        # Check for main components
        widget_types = [type(w).__name__ for w in widgets]
        assert "Header" in widget_types
        assert "Footer" in widget_types
        
        # Should have status, viewstate, and events displays
        has_status = False
        has_viewstate = False  
        has_events = False
        
        for widget in widgets:
            if hasattr(widget, 'id'):
                if widget.id == "status":
                    has_status = True
                elif widget.id == "viewstate":
                    has_viewstate = True
                elif widget.id == "events":
                    has_events = True
        
        # Note: Due to nested containers, we may need to check differently
        # For now, just verify the compose method runs without error
        assert len(widgets) > 0
    
    @pytest.mark.asyncio
    async def test_on_mount_starts_update_task(self, ui):
        """Test on_mount starts the update task"""
        # Mock asyncio.create_task
        mock_task = MagicMock()
        
        with patch('asyncio.create_task', return_value=mock_task) as mock_create:
            ui.on_mount()
            
            # Verify task was created
            mock_create.assert_called_once()
            assert ui.update_task == mock_task
    
    @pytest.mark.asyncio 
    async def test_update_display(self, ui, mock_client):
        """Test update_display updates the UI"""
        # Mock query_one
        mock_status = MagicMock()
        mock_viewstate = MagicMock() 
        mock_events = MagicMock()
        
        ui.query_one = MagicMock(side_effect=lambda id: {
            "#status": mock_status,
            "#viewstate": mock_viewstate,
            "#events": mock_events
        }.get(id))
        
        # Add some events
        mock_client.events = [
            {"type": "goto", "data": {"ra": 10, "dec": 20}},
            {"type": "tracking", "data": {"status": "active"}}
        ]
        
        # Call update_display
        await ui.update_display()
        
        # Verify status update
        mock_status.update.assert_called_once()
        status_text = mock_status.update.call_args[0][0]
        assert "Connected" in status_text
        assert "192.168.1.100:4700" in status_text
        
        # Verify viewstate update
        mock_viewstate.update.assert_called_once()
        viewstate_text = mock_viewstate.update.call_args[0][0]
        assert "RA: 12.5" in viewstate_text
        assert "Dec: 45.2" in viewstate_text
        assert "Mode: tracking" in viewstate_text
        
        # Verify events update
        mock_events.update.assert_called_once()
        events_text = mock_events.update.call_args[0][0]
        assert "goto" in events_text
        assert "tracking" in events_text
    
    @pytest.mark.asyncio
    async def test_update_display_handles_exceptions(self, ui, mock_client):
        """Test update_display handles exceptions gracefully"""
        # Make get_view_state raise exception
        mock_client.get_view_state = AsyncMock(side_effect=Exception("Connection error"))
        
        # Mock query_one
        mock_viewstate = MagicMock()
        ui.query_one = MagicMock(return_value=mock_viewstate)
        
        # Should not raise exception
        await ui.update_display()
        
        # Should show error in viewstate
        mock_viewstate.update.assert_called()
        update_text = mock_viewstate.update.call_args[0][0]
        assert "Error" in update_text or "error" in update_text
    
    @pytest.mark.asyncio
    async def test_key_q_exits_app(self, ui):
        """Test pressing 'q' exits the app"""
        # Mock exit
        ui.exit = MagicMock()
        
        # Call key handler
        await ui.on_key("q")
        
        # Verify exit was called
        ui.exit.assert_called_once()
    
    @pytest.mark.asyncio
    async def test_cleanup_on_unmount(self, ui):
        """Test cleanup when UI is unmounted"""
        # Create a mock task
        mock_task = MagicMock()
        mock_task.cancel = MagicMock()
        ui.update_task = mock_task
        
        # Call on_unmount
        await ui.on_unmount()
        
        # Verify task was cancelled
        mock_task.cancel.assert_called_once()
        
        # Test with no task
        ui.update_task = None
        await ui.on_unmount()  # Should not raise


class TestUIIntegration:
    """Integration tests for UI components"""
    
    @pytest.mark.asyncio
    async def test_device_picker_flow(self):
        """Test complete device picker flow"""
        devices = [
            {"address": "192.168.1.100", "data": {"name": "Test Device"}}
        ]
        
        app = DevicePickerApp(devices)
        
        # We can't easily test the full Textual app lifecycle
        # but we can verify the structure
        assert app.devices == devices
        
        # Test that on_mount would create the right screen
        with patch.object(app, 'push_screen') as mock_push:
            app.on_mount()
            
            # Verify screen was pushed
            assert mock_push.called
            screen = mock_push.call_args[0][0]
            assert isinstance(screen, DevicePickerScreen)
            assert screen.devices == devices
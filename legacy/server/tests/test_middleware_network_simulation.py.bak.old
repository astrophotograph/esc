import pytest
import asyncio
import time
from unittest.mock import MagicMock, patch, AsyncMock
from dataclasses import dataclass
from typing import Optional

from fastapi import Request, Response
from fastapi.responses import StreamingResponse, FileResponse
from starlette.datastructures import Headers

from middleware.network_simulation import (
    NetworkSimulationConfig,
    NetworkSimulationState,
    NetworkSimulationMiddleware,
    NETWORK_PRESETS
)


class TestNetworkSimulationConfig:
    """Test the NetworkSimulationConfig class"""
    
    def test_default_config(self):
        """Test default configuration values"""
        config = NetworkSimulationConfig()
        
        assert config.base_delay_ms == 0.0
        assert config.delay_variation_ms == 0.0
        assert config.packet_loss_rate == 0.0
        assert config.bandwidth_limit_kbps is None
        assert config.connection_drop_rate == 0.0
        assert config.timeout_rate == 0.0
        assert config.timeout_delay_ms == 10000.0
        assert config.enabled is False
        
        # Check default paths
        assert "/api/processing/" in config.apply_to_paths
        assert ".png" in config.apply_to_paths
        assert ".fits" in config.apply_to_paths
    
    def test_custom_config(self):
        """Test custom configuration"""
        config = NetworkSimulationConfig(
            base_delay_ms=100.0,
            delay_variation_ms=50.0,
            packet_loss_rate=0.1,
            bandwidth_limit_kbps=1000.0,
            connection_drop_rate=0.05,
            timeout_rate=0.02,
            timeout_delay_ms=5000.0,
            apply_to_paths=["/api/", "/custom/"],
            enabled=True
        )
        
        assert config.base_delay_ms == 100.0
        assert config.delay_variation_ms == 50.0
        assert config.packet_loss_rate == 0.1
        assert config.bandwidth_limit_kbps == 1000.0
        assert config.enabled is True
        assert config.apply_to_paths == ["/api/", "/custom/"]
    
    def test_config_validation(self):
        """Test configuration boundary values"""
        # Valid values
        config = NetworkSimulationConfig(
            packet_loss_rate=0.0,
            connection_drop_rate=1.0,
            timeout_rate=0.5
        )
        
        assert config.packet_loss_rate == 0.0
        assert config.connection_drop_rate == 1.0
        assert config.timeout_rate == 0.5


class TestNetworkSimulationState:
    """Test the NetworkSimulationState class"""
    
    def test_singleton_pattern(self):
        """Test that NetworkSimulationState is a singleton"""
        state1 = NetworkSimulationState()
        state2 = NetworkSimulationState()
        
        # Should be the same instance
        assert state1 is state2
        assert state1.config is state2.config
    
    def test_state_initialization(self):
        """Test state initialization"""
        # Reset singleton
        NetworkSimulationState._instance = None
        state = NetworkSimulationState()
        
        assert isinstance(state.config, NetworkSimulationConfig)
        assert state.config.enabled is False
        assert state._start_time is not None
        assert state._request_count == 0
        assert state._bytes_throttled == 0
        assert state._requests_delayed == 0
        assert state._packets_dropped == 0
        assert state._connections_dropped == 0
    
    def test_update_config(self):
        """Test updating configuration"""
        state = NetworkSimulationState()
        
        new_config = NetworkSimulationConfig(
            base_delay_ms=200.0,
            enabled=True
        )
        
        state.update_config(new_config)
        
        assert state.config.base_delay_ms == 200.0
        assert state.config.enabled is True
    
    def test_get_stats(self):
        """Test getting statistics"""
        state = NetworkSimulationState()
        state._request_count = 100
        state._bytes_throttled = 1024000
        state._requests_delayed = 50
        state._packets_dropped = 10
        state._connections_dropped = 2
        
        stats = state.get_stats()
        
        assert stats["enabled"] == state.config.enabled
        assert stats["request_count"] == 100
        assert stats["bytes_throttled"] == 1024000
        assert stats["requests_delayed"] == 50
        assert stats["packets_dropped"] == 10
        assert stats["connections_dropped"] == 2
        assert "uptime_seconds" in stats
        assert "config" in stats


class TestSimulationFunctions:
    """Test individual simulation functions"""
    
    @pytest.mark.asyncio
    async def test_simulate_latency(self):
        """Test latency simulation"""
        config = NetworkSimulationConfig(
            base_delay_ms=100.0,
            delay_variation_ms=20.0
        )
        
        with patch('middleware.network_simulation.random.uniform', return_value=10.0):
            start_time = time.time()
            await simulate_latency(config)
            elapsed = time.time() - start_time
            
            # Should have delayed approximately 110ms (100 + 10)
            assert elapsed >= 0.11
            assert elapsed < 0.15  # Allow some overhead
    
    @pytest.mark.asyncio
    async def test_simulate_latency_zero_delay(self):
        """Test latency simulation with zero delay"""
        config = NetworkSimulationConfig(
            base_delay_ms=0.0,
            delay_variation_ms=0.0
        )
        
        start_time = time.time()
        await simulate_latency(config)
        elapsed = time.time() - start_time
        
        # Should have minimal delay
        assert elapsed < 0.01
    
    def test_simulate_packet_loss_not_dropped(self):
        """Test packet loss simulation when packet is not dropped"""
        config = NetworkSimulationConfig(packet_loss_rate=0.3)
        
        with patch('middleware.network_simulation.random.random', return_value=0.5):
            result = simulate_packet_loss(config)
            assert result is False  # Packet not dropped
    
    def test_simulate_packet_loss_dropped(self):
        """Test packet loss simulation when packet is dropped"""
        config = NetworkSimulationConfig(packet_loss_rate=0.3)
        
        with patch('middleware.network_simulation.random.random', return_value=0.2):
            result = simulate_packet_loss(config)
            assert result is True  # Packet dropped
    
    def test_simulate_packet_loss_zero_rate(self):
        """Test packet loss with zero loss rate"""
        config = NetworkSimulationConfig(packet_loss_rate=0.0)
        
        # Should never drop packets
        for _ in range(10):
            assert simulate_packet_loss(config) is False
    
    @pytest.mark.asyncio
    async def test_throttle_bandwidth(self):
        """Test bandwidth throttling calculation"""
        config = NetworkSimulationConfig(bandwidth_limit_kbps=1000.0)  # 1 Mbps
        
        # Test with 1KB chunk
        chunk_size = 1024
        start_time = time.time()
        
        with patch('middleware.network_simulation.logging'):
            await throttle_bandwidth(config, chunk_size)
        
        elapsed = time.time() - start_time
        
        # 1KB at 1Mbps should take approximately 8ms
        # (1024 bytes * 8 bits/byte) / (1000 kbps * 1000 bits/kbit) = 0.008192s
        assert elapsed >= 0.008
        assert elapsed < 0.02  # Allow overhead
    
    @pytest.mark.asyncio
    async def test_throttle_bandwidth_no_limit(self):
        """Test bandwidth throttling with no limit"""
        config = NetworkSimulationConfig(bandwidth_limit_kbps=None)
        
        start_time = time.time()
        await throttle_bandwidth(config, 1024000)  # 1MB
        elapsed = time.time() - start_time
        
        # Should have minimal delay
        assert elapsed < 0.01


class TestNetworkSimulationMiddleware:
    """Test the NetworkSimulationMiddleware class"""
    
    @pytest.fixture
    def mock_request(self):
        """Create mock request"""
        request = MagicMock(spec=Request)
        request.url.path = "/api/processing/image.png"
        request.method = "GET"
        return request
    
    @pytest.fixture
    def mock_app(self):
        """Create mock ASGI app"""
        return MagicMock()
    
    @pytest.fixture
    def middleware(self, mock_app):
        """Create middleware instance"""
        return NetworkSimulationMiddleware(mock_app)
    
    @pytest.mark.asyncio
    async def test_middleware_disabled(self, middleware, mock_request):
        """Test middleware when simulation is disabled"""
        # Disable simulation
        state = NetworkSimulationState()
        state.config.enabled = False
        
        # Mock response
        mock_response = Response(content="test", status_code=200)
        
        async def call_next(request):
            return mock_response
        
        response = await middleware.dispatch(mock_request, call_next)
        
        assert response == mock_response
        assert state._request_count == 0  # No stats updated
    
    @pytest.mark.asyncio
    async def test_middleware_path_not_matched(self, middleware, mock_request):
        """Test middleware with non-matching path"""
        # Enable simulation but use non-matching path
        state = NetworkSimulationState()
        state.config.enabled = True
        state.config.apply_to_paths = ["/other/"]
        
        mock_request.url.path = "/api/status"
        
        mock_response = Response(content="test", status_code=200)
        
        async def call_next(request):
            return mock_response
        
        response = await middleware.dispatch(mock_request, call_next)
        
        assert response == mock_response
        assert state._request_count == 0  # No simulation applied
    
    @pytest.mark.asyncio
    async def test_middleware_with_latency(self, middleware, mock_request):
        """Test middleware applies latency"""
        state = NetworkSimulationState()
        state.update_config(NetworkSimulationConfig(
            enabled=True,
            base_delay_ms=50.0,
            delay_variation_ms=0.0,
            apply_to_paths=["/api/"]
        ))
        
        mock_response = Response(content="test", status_code=200)
        
        async def call_next(request):
            return mock_response
        
        start_time = time.time()
        
        with patch('middleware.network_simulation.logging'):
            response = await middleware.dispatch(mock_request, call_next)
        
        elapsed = time.time() - start_time
        
        assert response == mock_response
        assert elapsed >= 0.05  # At least 50ms delay
        assert state._requests_delayed > 0
    
    @pytest.mark.asyncio
    async def test_middleware_connection_drop(self, middleware, mock_request):
        """Test middleware dropping connections"""
        state = NetworkSimulationState()
        state.update_config(NetworkSimulationConfig(
            enabled=True,
            connection_drop_rate=1.0,  # Always drop
            apply_to_paths=["/api/"]
        ))
        
        mock_response = Response(content="test", status_code=200)
        
        async def call_next(request):
            return mock_response
        
        with patch('middleware.network_simulation.logging'):
            with pytest.raises(ConnectionError):
                await middleware.dispatch(mock_request, call_next)
        
        assert state._connections_dropped > 0
    
    @pytest.mark.asyncio
    async def test_middleware_packet_loss(self, middleware, mock_request):
        """Test middleware with packet loss"""
        state = NetworkSimulationState()
        state.update_config(NetworkSimulationConfig(
            enabled=True,
            packet_loss_rate=1.0,  # Always drop packets
            apply_to_paths=["/api/"]
        ))
        
        mock_response = Response(content="test", status_code=200)
        
        async def call_next(request):
            return mock_response
        
        with patch('middleware.network_simulation.logging'):
            response = await middleware.dispatch(mock_request, call_next)
        
        # Response should be truncated or empty due to packet loss
        assert response.status_code == 200
        assert state._packets_dropped > 0
    
    @pytest.mark.asyncio
    async def test_middleware_streaming_response(self, middleware, mock_request):
        """Test middleware with streaming response"""
        state = NetworkSimulationState()
        state.update_config(NetworkSimulationConfig(
            enabled=True,
            bandwidth_limit_kbps=1000.0,  # 1 Mbps
            apply_to_paths=["/api/"]
        ))
        
        # Create streaming response
        async def generate():
            for i in range(3):
                yield b"chunk"
        
        mock_response = StreamingResponse(generate(), media_type="text/plain")
        
        async def call_next(request):
            return mock_response
        
        with patch('middleware.network_simulation.logging'):
            response = await middleware.dispatch(mock_request, call_next)
        
        # Should return a wrapped streaming response
        assert isinstance(response, StreamingResponse)
        
        # Consume the response to trigger throttling
        chunks = []
        async for chunk in response.body_iterator:
            chunks.append(chunk)
        
        assert len(chunks) == 3
        assert state._bytes_throttled > 0
    
    @pytest.mark.asyncio
    async def test_middleware_file_response(self, middleware, mock_request):
        """Test middleware with file response"""
        state = NetworkSimulationState()
        state.update_config(NetworkSimulationConfig(
            enabled=True,
            bandwidth_limit_kbps=1000.0,
            apply_to_paths=["/api/"]
        ))
        
        # Create file response
        mock_response = FileResponse("test.txt")
        
        async def call_next(request):
            return mock_response
        
        with patch('middleware.network_simulation.logging'):
            response = await middleware.dispatch(mock_request, call_next)
        
        # Should handle file response
        assert isinstance(response, (FileResponse, StreamingResponse))


class TestNetworkPresets:
    """Test network simulation presets"""
    
    def test_presets_exist(self):
        """Test that all expected presets exist"""
        expected_presets = [
            "off",
            "slow_3g",
            "slow_4g", 
            "unstable_wifi",
            "satellite",
            "high_latency",
            "packet_loss",
            "telescope_field"
        ]
        
        for preset in expected_presets:
            assert preset in NETWORK_PRESETS
    
    def test_preset_configurations(self):
        """Test preset configurations are valid"""
        for name, config in NETWORK_PRESETS.items():
            assert isinstance(config, NetworkSimulationConfig)
            
            # Validate ranges
            assert 0.0 <= config.packet_loss_rate <= 1.0
            assert 0.0 <= config.connection_drop_rate <= 1.0
            assert 0.0 <= config.timeout_rate <= 1.0
            assert config.base_delay_ms >= 0.0
            assert config.delay_variation_ms >= 0.0
            
            if config.bandwidth_limit_kbps is not None:
                assert config.bandwidth_limit_kbps > 0
    
    def test_off_preset(self):
        """Test 'off' preset disables simulation"""
        config = NETWORK_PRESETS["off"]
        assert config.enabled is False
        assert config.base_delay_ms == 0.0
        assert config.packet_loss_rate == 0.0
    
    def test_slow_3g_preset(self):
        """Test 'slow_3g' preset parameters"""
        config = NETWORK_PRESETS["slow_3g"]
        assert config.enabled is True
        assert config.base_delay_ms >= 100.0  # High latency
        assert config.bandwidth_limit_kbps <= 400.0  # Low bandwidth
        assert config.packet_loss_rate > 0.0  # Some packet loss


class TestNetworkSimulationIntegration:
    """Integration tests for network simulation"""
    
    @pytest.mark.asyncio
    async def test_full_simulation_flow(self):
        """Test complete simulation flow with multiple effects"""
        # Configure simulation
        state = NetworkSimulationState()
        state.update_config(NetworkSimulationConfig(
            enabled=True,
            base_delay_ms=10.0,
            packet_loss_rate=0.1,
            bandwidth_limit_kbps=1000.0,
            apply_to_paths=["/"]
        ))
        
        # Create middleware
        app = MagicMock()
        middleware = NetworkSimulationMiddleware(app)
        
        # Create request
        request = MagicMock()
        request.url.path = "/api/image.png"
        request.method = "GET"
        
        # Create response with content
        response = Response(content=b"x" * 1024, status_code=200)
        
        async def call_next(req):
            return response
        
        # Run simulation
        start_time = time.time()
        
        with patch('middleware.network_simulation.logging'):
            with patch('middleware.network_simulation.random.random', return_value=0.5):
                result = await middleware.dispatch(request, call_next)
        
        elapsed = time.time() - start_time
        
        # Should have some delay
        assert elapsed >= 0.01
        
        # Stats should be updated
        stats = state.get_stats()
        assert stats["request_count"] > 0
        assert stats["requests_delayed"] > 0
# Docker Compose Environment Variables

# Server Configuration
SERVER_PORT=8000
PYTHON_ENV=development
LOG_LEVEL=DEBUG

# UI Configuration  
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_HOST=localhost:8000


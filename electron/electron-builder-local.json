{
  "appId": "com.alp.experimental.local",
  "productName": "ALP Experimental",
  "directories": {
    "output": "../dist"
  },
  "files": [
    "main.js",
    "preload.js", 
    "processManager.js",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "../build/alp-experimental-server",
      "to": "server",
      "filter": ["**/*"]
    },
    {
      "from": "../build/ui",
      "to": "ui",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "target": [
      {
        "target": "dir"
      }
    ],
    "icon": "assets/icon.icns"
  },
  "compression": "store"
}

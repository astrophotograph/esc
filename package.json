{
  "name": "eesc",
  "version": "0.1.0",
  "description": "Telescope control application with observation planning and image management",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "PYO3_PYTHON=$PWD/.venv/bin/python tauri dev",
    "tauri:build": "PYO3_PYTHON=$PWD/.venv/bin/python tauri build",
    "web:dev": "vite --mode web",
    "web:build": "tsc && vite build --mode web",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:python": "uv run pytest",
    "test:rust": "cd src-tauri && cargo test",
    "test:all": "pnpm test:python && pnpm test:rust && pnpm test",
    "lint": "prettier --check . && tsc --noEmit",
    "lint:python": "uv run ruff check src-tauri/python",
    "format": "prettier --write .",
    "format:python": "uv run ruff format src-tauri/python"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.3.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.5",
    "vitest": "^2.1.0"
  }
}
